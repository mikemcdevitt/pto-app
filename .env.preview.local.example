# Copy this file to .env.preview.local (gitignored) -- used ONLY by
# scripts/seed-preview.ts. See docs/preview-environment.md.

# Connection string for the PREVIEW Neon branch/database. Never your real one:
# the seed script refuses to run if this points at the same host as .env.local.
DATABASE_URL=

# Optional: your own email. If set, one seeded parent gets this address, so you
# can sign in to the preview as a parent and see a dashboard with a few kids.
SEED_TEST_PARENT_EMAIL=
