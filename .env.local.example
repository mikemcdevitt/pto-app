# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres connection string (used by src/db, drizzle.config.ts, and middleware.ts)
DATABASE_URL=

# Comma-separated emails allowed into /admin (see src/lib/require-admin.ts)
ADMIN_EMAILS=

# Google OAuth credentials for sign-in (src/auth.ts uses the bare Google provider,
# so Auth.js v5 reads these by convention: AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js v5 session signing secret — generate with: npx auth secret
AUTH_SECRET=

# --- Wix donation -> grade participation chart ---
# Wix Business Manager > Settings > API Keys (needs eCommerce Orders: Read)
WIX_API_KEY=
# Wix Business Manager > Settings, or next to the API key
WIX_SITE_ID=
# The Annual Appeal campaign's ID (Wix Dashboard > Donations > open the campaign, check the URL)
WIX_DONATION_CAMPAIGN_ID=
# Must exactly match a school_years.label row already in the DB, e.g. "2025-2026"
CURRENT_SCHOOL_YEAR_LABEL=
# Shared secret for the cron route; generate any random string and set the same value on Vercel Cron
CRON_SECRET=
